# Target location
KARUVOTTAM_LOCATION_NAME=பொறுப்புமேட்டுப்பட்டி, உசிலம்பட்டி வட்டம், மதுரை மாவட்டம்
KARUVOTTAM_LATITUDE=9.9040188
KARUVOTTAM_LONGITUDE=77.8860417
# Replace this default when a verified site elevation is available.
KARUVOTTAM_ELEVATION_M=0
KARUVOTTAM_TIMEZONE=Asia/Kolkata

# Custom calendar rule: MM-DD = Chithirai 1
KARUVOTTAM_CHITHIRAI_REFERENCE=03-21
KARUVOTTAM_CALENDAR_RULE_VERSION=1.0

# Weather provider
KARUVOTTAM_WEATHER_PROVIDER=open-meteo
# ERA5 is required because ERA5-Land does not expose every required hourly field.
KARUVOTTAM_WEATHER_MODEL=era5
KARUVOTTAM_WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
# Leave blank unless the selected provider requires a key. Never commit the real value.
KARUVOTTAM_WEATHER_API_KEY=
KARUVOTTAM_WEATHER_TIMEOUT_SECONDS=30
KARUVOTTAM_WEATHER_RETRY_ATTEMPTS=3
KARUVOTTAM_WEATHER_RETRY_BACKOFF_SECONDS=1
KARUVOTTAM_WEATHER_RAW_DATA_DIR=data/imports/weather/raw

# SQLite persistence (relative paths are resolved from the project root)
KARUVOTTAM_DATABASE_PATH=data/karuvottam.sqlite3

# Local development server
KARUVOTTAM_PORT=5000
